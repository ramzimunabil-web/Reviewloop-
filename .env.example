# --- Database (Postgres). Use Neon, Supabase, or Railway in production ---
DATABASE_URL="postgresql://user:password@localhost:5432/reviewloop?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Price IDs created in your Stripe dashboard (recurring/monthly)
STRIPE_PRICE_STARTER="price_xxx"
STRIPE_PRICE_PRO="price_xxx"
STRIPE_PRICE_GROWTH="price_xxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"
EMAIL_FROM="ReviewLoop <hello@yourdomain.com>"

# --- Admin access (comma-separated emails that can see /admin) ---
ADMIN_EMAILS="you@yourdomain.com"
